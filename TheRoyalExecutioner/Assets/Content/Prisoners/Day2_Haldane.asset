  m_Script: {fileID: 11500000, guid: f0d95dc40e90149959e6f92ccf96e3b6, type: 3}
  m_Name: Day2_Haldane
  m_EditorClassIdentifier: 
  <prisonerName>k__BackingField: "Tax Reeve Haldane"
  <crime>k__BackingField: "Falsifying a warrant (the Crown found out)"
  <orderText>k__BackingField: "Beheading at noon, before the Chancellery's attention wanders. Fee: 30 coin."
  <fileText>k__BackingField: "Someone had to answer for the misdated warrant, and the Chancellery has chosen the man who filed it. Haldane is led in still holding his abacus. He has requested a final word, which is permitted, and a bribe, which is not, and has chosen to combine them.\n\nA sack of flour sits at the foot of the scaffold, tagged 'with thanks, E. Lowe'. Nobody has dared move it."
  <fee>k__BackingField: 30
  <requirement>k__BackingField:
    required: 1
    forbidden: 0
  <scrutinyIfClean>k__BackingField: 0
  <scrutinyIfNotClean>k__BackingField: 1
  <cleanExecutionText>k__BackingField: "Haldane tries to settle the matter by quoting statutes. The axe settles it first. The abacus, dropped, rolls off the scaffold and keeps counting for some time."
  <messyExecutionText>k__BackingField: "It takes two strokes, and Haldane spends the interval explaining that this is an irregularity. The Clerk of Corrections agrees, and files it."
  <botchedExecutionText>k__BackingField: "The axe glances off the abacus he refuses to put down. Haldane objects on procedural grounds until the fourth stroke."
  <hasChallenge>k__BackingField: 0
  <challenge>k__BackingField:
    <label>k__BackingField: ""
    <resultText>k__BackingField: ""
    <method>k__BackingField: 0
    <moneyChange>k__BackingField: 0
    <scrutinyChange>k__BackingField: 0
    <flagToSet>k__BackingField: 0
    <requiresExamination>k__BackingField: 0
    <isUnofficial>k__BackingField: 0
    <requirement>k__BackingField:
      required: 0
      forbidden: 0
  <contextualChoices>k__BackingField:
  - <label>k__BackingField: "Take Haldane's offer: a flour barrel and a quiet cart"
    <resultText>k__BackingField: "Seventy coin, a barrel with a false bottom and no questions. The Crown receives a convincing hat and a sack of ashes. The barrel rolls away down the hill, with a faint rattle of abacus beads inside."
    <method>k__BackingField: 0
    <moneyChange>k__BackingField: 70
    <scrutinyChange>k__BackingField: 2
    <flagToSet>k__BackingField: 0
    <requiresExamination>k__BackingField: 0
    <isUnofficial>k__BackingField: 1
    <requirement>k__BackingField:
      required: 0
      forbidden: 0
